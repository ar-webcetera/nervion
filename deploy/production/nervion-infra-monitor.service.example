[Unit]
Description=Read-only Nervion infrastructure health checks
After=docker.service network-online.target
OnFailure=nervion-ops-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/nervion-ops/infra-monitor.py --config /etc/nervion-ops/infra-monitor.json
TimeoutStartSec=55
MemoryMax=96M
TasksMax=64
StateDirectory=nervion-ops/infra-monitor
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nervion-ops/infra-monitor
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
