# Install as /run/secrets/pgbackrest_config, owner postgres, mode 0600.
# Placeholders are deliberately rejected. Never commit the completed file.
[global]
repo1-type=s3
repo1-path=/nervion-backups/production/pgbackrest
repo1-s3-bucket=REPLACE_PRIVATE_BUCKET
repo1-s3-endpoint=REPLACE_S3_HOSTNAME
repo1-s3-region=REPLACE_REGION
repo1-s3-key-type=shared
repo1-s3-key=REPLACE_ACCESS_KEY
repo1-s3-key-secret=REPLACE_SECRET_ACCESS_KEY
repo1-s3-uri-style=path
repo1-storage-verify-tls=y
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_SEPARATELY_STORED_RANDOM_PASSPHRASE
repo1-retention-full-type=time
repo1-retention-full=35
# Defaults retain every differential backup and all WAL needed by retained fulls.
archive-async=n
archive-timeout=120
start-fast=y
process-max=2
compress-type=zst
log-level-console=info
log-level-file=off

[nervion]
pg1-path=/var/lib/postgresql/data/pgdata
pg1-socket-path=/var/run/postgresql
pg1-user=postgres
pg1-port=5432
pg1-database=postgres
