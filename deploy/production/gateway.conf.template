map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}
server {
  listen ${PRODUCTION_INGRESS_BIND_IP}:${PRODUCTION_HTTP_PORT} default_server;
  server_name _;
  location = /__nervion_health { return 200 'ok'; }
  location / { return 444; }
}
server {
  listen ${PRODUCTION_INGRESS_BIND_IP}:${PRODUCTION_HTTP_PORT};
  server_name ${PRODUCTION_ADMIN_HOST} *.${PRODUCTION_ROOT_DOMAIN};
  client_max_body_size 128m;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Host "";
  proxy_set_header X-Nervion-Host "";
  proxy_set_header X-Nervion-Timestamp "";
  proxy_set_header X-Nervion-Signature "";
  location /api/ {
    proxy_pass http://127.0.0.1:${PRODUCTION_BACKEND_PORT};
    proxy_http_version 1.1;
    proxy_read_timeout 120s;
    proxy_buffering off;
  }
  location /socket.io/ {
    proxy_pass http://127.0.0.1:${PRODUCTION_BACKEND_PORT};
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # A location with its own proxy_set_header does not inherit server headers.
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Nervion-Host "";
    proxy_set_header X-Nervion-Timestamp "";
    proxy_set_header X-Nervion-Signature "";
  }
  location / {
    proxy_pass http://127.0.0.1:${PRODUCTION_FRONTEND_PORT};
    proxy_http_version 1.1;
    proxy_read_timeout 120s;
  }
}
