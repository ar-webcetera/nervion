# Copy outside the repository. Do not reuse production values or credentials.
PREPROD_PROJECT_NAME=nervion-preprod
PREPROD_SECRETS_DIR=/absolute/private/preprod-secrets
PREPROD_ROOT_DOMAIN=preprod.example.com
PREPROD_ADMIN_HOST=admin.preprod.example.com
PREPROD_ADMIN_EMAIL=operator@example.com
# A fixed fresh UUID; empty data databases have no legacy client to bootstrap.
PREPROD_BOOTSTRAP_TENANT_ID=
PREPROD_HTTP_PORT=3088
# Use loopback, or the existing reverse proxy's private host-gateway address.
# Never bind this HTTP gateway to a public interface.
PREPROD_HTTP_BIND_IP=127.0.0.1
PREPROD_MEDIA_PUBLIC_IP=
PREPROD_MEDIA_MIN_PORT=52000
PREPROD_MEDIA_MAX_PORT=52099
PREPROD_TURN_URLS=
PREPROD_GIT_ALLOWED_HOSTS=
PREPROD_HEALTHCHECK_ALLOWED_HOSTS=
# Prefer verified immutable image digests in the deployed copy.
PREPROD_STORAGE_IMAGE=chrislusf/seaweedfs:4.51
