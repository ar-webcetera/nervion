# ============================================================================
#  Backend (NestJS) — пример конфигурации. Скопируйте в apps/backend/.env
#  Значения-плейсхолдеры; реальные секреты НЕ коммитить (.env в .gitignore).
#  Секреты помечены [secret].
# ============================================================================

# --- Базовое ---
NODE_ENV=development
PORT=3026
# Необязательно: IP HTTP-интерфейса. Без значения сохраняется общий bind.
# Для production за локальным proxy используйте loopback.
# BACKEND_BIND_HOST=127.0.0.1
# Публичный домен бэкенда (для ссылок/служебной логики)
APP_DOMAIN=localhost:3026
# Публичный origin веб-приложения для ссылок в письмах и уведомлениях
APP_PUBLIC_ORIGIN=http://localhost:3000
# Origin фронтенда-студии (для CORS/редиректов)

# --- База данных (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # [secret]
POSTGRES_DB=tracker
# Максимум соединений в пуле (основной процесс / SMTP-процесс)
DB_POOL_MAX=10
SMTP_DB_POOL_MAX=5

# --- Managed SaaS (опционально, по умолчанию self-hosted) ---
# Включать после отдельных platform/data/tenant миграций и bootstrap первого клиента.
TENANCY_ENABLED=false
TENANCY_BOOTSTRAP_TENANT_ID=
TENANCY_BOOTSTRAP_SLUG=webcetera
TENANCY_BOOTSTRAP_HOSTNAME=webcetera.nervion.ru
TENANCY_ROOT_DOMAIN=nervion.ru
# Пусто: максимум из 100 и числа активных пользователей текущего пространства.
TENANCY_BOOTSTRAP_SEAT_LIMIT=
# Общий секрет backend и Nuxt SSR для проверки переданного hostname. [secret]
TENANCY_PROXY_SECRET=
# Runtime через PgBouncer: POSTGRES_USER=nervion_data, POSTGRES_DB=nervion_data_1.
# Миграции подключаются напрямую к PostgreSQL отдельной ролью.
MIGRATION_POSTGRES_HOST=
MIGRATION_POSTGRES_PORT=
MIGRATION_POSTGRES_USER=
MIGRATION_POSTGRES_PASSWORD= # [secret]
# Platform runtime через отдельный пул PgBouncer.
PLATFORM_POSTGRES_HOST=localhost
PLATFORM_POSTGRES_PORT=6432
PLATFORM_POSTGRES_DB=nervion_platform
PLATFORM_POSTGRES_USER=nervion_platform
PLATFORM_POSTGRES_PASSWORD= # [secret]
PLATFORM_MIGRATION_POSTGRES_HOST=localhost
PLATFORM_MIGRATION_POSTGRES_PORT=5432
PLATFORM_MIGRATION_POSTGRES_USER=
PLATFORM_MIGRATION_POSTGRES_PASSWORD= # [secret]
PLATFORM_ADMIN_HOST=admin.nervion.ru
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD_HASH= # [secret] scrypt hash, см. docs/saas.md
# Обязателен для доставки WebSocket-событий между репликами в SaaS.
REDIS_URL=redis://127.0.0.1:6380
# При отсутствии JSON единственный data_1 использует POSTGRES_*.
# Массив {id,host,port,database,username,password}; реальные credentials вне git.
DATA_SHARDS_JSON=
# Обработка зарегистрированных tenant jobs. SMTP-процесс отключает ее сам.
TENANT_JOBS_WORKER_ENABLED=true
# Число параллельно обслуживаемых tenants, 1-16; оставьте запас DB_POOL_MAX для HTTP.
TENANT_JOBS_CONCURRENCY=4

# --- Аутентификация ---
JWT_SECRET=                  # [secret] обязателен в SaaS, одинаковый у всех реплик
JWT_EXPIRES_IN=30d            # сек или суффиксы s/m/h/d
# Первый администратор создаётся один раз, только если таблица users пуста.
INITIAL_ADMIN_EMAIL=admin@nervion.local
INITIAL_ADMIN_PASSWORD=change-me-before-first-start  # [secret] обязательно замените
INITIAL_ADMIN_FIRST_NAME=Администратор
INITIAL_ADMIN_LAST_NAME=Нервион
# Публичный origin приложения для OAuth-callback (напр. https://app.nervion.ru). Пусто = из заголовков запроса.
AUTH_PUBLIC_ORIGIN=
# Яндекс ID OAuth — https://oauth.yandex.ru/
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=   # [secret]
# SaaS: точные hostname через запятую с зарегистрированным HTTPS callback /api/auth/yandex/callback.
# Пусто: OAuth отключен. Доступен только вход уже привязанных пользователей, без автопривязки по email.
YANDEX_OAUTH_TENANT_HOSTS=

# --- Демо-вход (опционально) ---
# Публичный авто-вход под демо-пользователем по ссылке GET /api/auth/demo.
# Включать ТОЛЬКО на демо/препрод-стенде; на проде оставить выключенным (иначе любой войдёт).
DEMO_AUTH_ENABLED=false
DEMO_AUTH_EMAIL=demo@example.com

# --- Web Push (VAPID) ---
# false: не отправлять push, не регистрировать подписки и не требовать VAPID.
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=            # [secret]

# --- S3-совместимое хранилище (файлы, медиа, аватары) ---
AWS_ACCESS_KEY_ID=            # [secret]
AWS_SECRET_ACCESS_KEY=        # [secret]
AWS_REGION=ru-1
# Endpoint без бакета (для S3-клиента), напр. https://s3.example.com
AWS_ENDPOINT=
AWS_BUCKET_ID=

# --- AI (опционально) ---
# false: API не требует ключи и отклоняет AI-запросы без обращения к провайдерам.
# На изолированном препроде выключить; по умолчанию true для совместимости.
AI_ENABLED=true
# Транскрибация голосовых, формулировка задач
OPENAI_API_KEY=              # [secret]
OPENROUTER_API_KEY=          # [secret]
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo

# --- Git (self-hosted репозитории на диске) ---
# Базовый URL для git clone, напр. https://git.example.com или git@server:/var/git
GIT_CLONE_BASE_URL=
# SaaS: отдельный persistent volume, общий для backend-реплик и workers.
GIT_TENANT_ROOT=
# Точные публичные hostname через запятую. Пусто запрещает новые подключения.
GIT_ALLOWED_HOSTS=
GIT_CREDENTIAL_KEY=          # [secret] 32 случайных байта в base64
GIT_MAX_REPO_BYTES=536870912
GIT_MAX_TENANT_BYTES=2147483648
GIT_MAX_REPOS_PER_TENANT=25
# SaaS: внешние репозитории читаются только через отдельный read-only mount.
# Каталог не должен пересекаться с GIT_TENANT_ROOT. Глобального fallback нет.
GIT_EXTERNAL_ROOT=
# JSON-массив {tenantId,repositoryId,gitdir,cloneUrl?}; только серверная конфигурация.
# cloneUrl задается оператором после проверки, SSH credentials в backend не передаются.
GIT_EXTERNAL_REPOSITORIES_JSON=[]
# Только одноразовая миграция. Исходные каталоги не удаляются.
GIT_MIGRATION_SOURCE_ROOTS=
GIT_MIGRATION_WRITES_STOPPED=false

# --- SaaS-мониторинг публичных сервисов ---
# Точные разрешенные hostname, без масок. Внутренние IP запрещены всегда.
HEALTHCHECK_ALLOWED_HOSTS=
HEALTHCHECK_TENANT_LIMIT=100

# --- Почтовый модуль трекера (mailbox: входящие через SMTP, исходящие через Postbox) ---
# Домен почтовых ящиков и алиасов task+ID@<домен>
MAILBOX_DOMAIN=example.com
# Ящик-получатель тредов с алиасов task+ID@ (по умолчанию первый service-аккаунт)
MAILBOX_TASK_ALIAS_ACCOUNT=
# Служебный ящик для календаря, задач и других системных уведомлений
MAILBOX_NOTIFICATION_ACCOUNT=bot@example.com
# Порт SMTP-приёмника входящей почты (публичная доставка по MX — порт 25)
SMTP_PORT=25
# Yandex Cloud Postbox (SES-совместимый) — исходящая почта
POSTBOX_ACCESS_KEY_ID=       # [secret]
POSTBOX_SECRET_ACCESS_KEY=   # [secret]
POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
POSTBOX_REGION=ru-central1
# Configuration set с Engagement statistics + подпиской на события (OPEN/CLICK/BOUNCE/COMPLAINT/DELIVERY)
POSTBOX_CONFIGURATION_SET=
# Секрет для webhook приёма событий: POST /api/mailbox/postbox-events (Authorization: Bearer …)
POSTBOX_EVENTS_WEBHOOK_SECRET=  # [secret]
# SaaS не использует общие MAILBOX_*/POSTBOX_* credentials выше.
# [secret] JSON-массив конфигураций клиентов. Схема: docs/saas-mail.md.
# Домены принадлежат одному tenant, оператор подтверждает DNS/Postbox ownership.
MAILBOX_TENANTS_JSON=
# TLS-сертификат и ключ SMTP, пути к примонтированным secret-файлам.
SMTP_TLS_CERT_FILE=
SMTP_TLS_KEY_FILE=

# --- Error tracking (Sentry / self-hosted GlitchTip) ---
# DSN GlitchTip для отслеживания ошибок (если пусто — Sentry выключен)
SENTRY_DSN=


# --- WebRTC (голос/видео, mediasoup) ---
# Публичный IP сервера для announcedIp; для локали можно 127.0.0.1
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
# Для запуска без Docker укажите абсолютный путь к скачанному mediasoup-worker.
# Версия бинарника должна совпадать с пакетом mediasoup в package.json.
MEDIASOUP_WORKER_BIN=
# JSON-массив ICE-серверов (опционально), напр. [{"urls":"stun:stun.l.google.com:19302"}]
MEDIASOUP_ICE_SERVERS=
# TURN для клиентов за NAT. В SaaS выдаются временные учетные данные.
MEDIASOUP_TURN_URLS=
MEDIASOUP_TURN_SECRET=       # [secret] минимум 32 символа, общий с coturn
MEDIASOUP_TURN_TTL_SECONDS=86400

# --- Исходящий прокси (опционально, напр. для доступа к внешним API) ---
PROXY_ENABLE=0
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=                  # [secret]
NO_PROXY=localhost,127.0.0.1,.local,openrouter.ai,login.yandex.ru,oauth.yandex.ru

# CORS: разрешённые origin'ы фронтендов (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# (опц.) разрешить все https-поддомены корневого хоста
CORS_ALLOWED_ROOT_HOST=

# --- Одноразовый перенос старых файлов, только migration job ---
# Явный список старых префиксов через запятую. Пустое значение запрещает запуск.
TENANCY_STORAGE_SOURCE_PREFIXES=
# Точные старые публичные URL бакета/CDN для переписывания ссылок в БД.
TENANCY_STORAGE_PUBLIC_BASE_URLS=
# Включается оператором только после остановки записи перед --apply.
TENANCY_STORAGE_WRITES_STOPPED=false
# Подтверждает единственного оператора при полном freeze всех источников записи.
# Все --apply используют также прямое MIGRATION_POSTGRES_* соединение для tenant lock.
TENANCY_STORAGE_EXCLUSIVE_WRITER=false
# Явный JSON-массив исходных ключей документов, например ["tracker-tasks/example.json"].
TENANCY_STORAGE_REWRITE_KEYS_JSON=[]
# Ограничение параллельных проверок/копирований: 1-8, по умолчанию 4.
TENANCY_STORAGE_COPY_CONCURRENCY=4
