# ============================================================================
#  Backend (NestJS) — пример конфигурации. Скопируйте в apps/backend/.env
#  Значения-плейсхолдеры; реальные секреты НЕ коммитить (.env в .gitignore).
#  Секреты помечены [secret].
# ============================================================================

# --- Базовое ---
NODE_ENV=development
PORT=3026
# Публичный домен бэкенда (для ссылок/служебной логики)
APP_DOMAIN=localhost:3026
# Origin фронтенда-студии (для CORS/редиректов)

# --- База данных (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # [secret]
POSTGRES_DB=tracker
# Максимум соединений в пуле (основной процесс / SMTP-процесс)
DB_POOL_MAX=10
SMTP_DB_POOL_MAX=5

# --- Аутентификация ---
JWT_EXPIRES_IN=30d            # сек или суффиксы s/m/h/d

# --- Демо-вход (опционально) ---
# Публичный авто-вход под демо-пользователем по ссылке GET /api/auth/demo.
# Включать ТОЛЬКО на демо/препрод-стенде; на проде оставить выключенным (иначе любой войдёт).
DEMO_AUTH_ENABLED=false
DEMO_AUTH_EMAIL=demo@example.com

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=            # [secret]

# --- S3-совместимое хранилище (файлы, медиа, аватары) ---
AWS_ACCESS_KEY_ID=            # [secret]
AWS_SECRET_ACCESS_KEY=        # [secret]
AWS_REGION=ru-1
# Endpoint без бакета (для S3-клиента), напр. https://s3.example.com
AWS_ENDPOINT=
AWS_BUCKET_ID=

# --- AI (опционально) ---
# Транскрибация голосовых, формулировка задач
OPENAI_API_KEY=              # [secret]
OPENROUTER_API_KEY=          # [secret]
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-large-v3

# --- Исходящая почта (SMTP) для заявок/уведомлений ---
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=                   # [secret]
MAIL_FROM="Tracker" <no-reply@example.com>

# --- Почтовый модуль трекера (mailbox: входящие через SMTP, исходящие через Postbox) ---
# Домен почтовых ящиков и алиасов task+ID@<домен>
MAILBOX_DOMAIN=example.com
# Ящик-получатель тредов с алиасов task+ID@ (по умолчанию первый service-аккаунт)
MAILBOX_TASK_ALIAS_ACCOUNT=
# Порт SMTP-приёмника входящей почты (публичная доставка по MX — порт 25)
SMTP_PORT=25
# Yandex Cloud Postbox (SES-совместимый) — исходящая почта
POSTBOX_ACCESS_KEY_ID=       # [secret]
POSTBOX_SECRET_ACCESS_KEY=   # [secret]
POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
POSTBOX_REGION=ru-central1

# --- Error tracking (Sentry / self-hosted GlitchTip) ---
# DSN GlitchTip для отслеживания ошибок (если пусто — Sentry выключен)
SENTRY_DSN=


# --- WebRTC (голос/видео, mediasoup) ---
# Публичный IP сервера для announcedIp; для локали можно 127.0.0.1
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
# JSON-массив ICE-серверов (опционально), напр. [{"urls":"stun:stun.l.google.com:19302"}]
MEDIASOUP_ICE_SERVERS=

# --- Исходящий прокси (опционально, напр. для доступа к внешним API) ---
PROXY_ENABLE=0
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=                  # [secret]
NO_PROXY=localhost,127.0.0.1

# CORS: разрешённые origin'ы фронтендов (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# (опц.) разрешить все https-поддомены корневого хоста
CORS_ALLOWED_ROOT_HOST=
