# ============================================================================
#  Frontend (Nuxt) — пример конфигурации. Скопируйте в apps/frontend/.env
#  Публичные значения (public runtime config) уходят в браузер — секреты сюда НЕ класть.
# ============================================================================

# Базовый URL backend API (бэкенд из apps/backend).
# В dev читается из API_URL; в проде значение можно переопределить
# на рантайме переменной NUXT_PUBLIC_API_URL.
API_URL=http://localhost:3026
# Внутренний URL backend для SSR. В Docker Compose: http://backend:3026
API_INTERNAL_URL=http://localhost:3026

# Публичная база S3-хранилища для разрешения ссылок на медиа в TipTap-контенте.
# ВАЖНО: бакет в виде поддомена (virtual-hosted), без пути:
#   https://<bucket>.<s3-host>
# Рантайм-переопределение: NUXT_PUBLIC_AWS_ENDPOINT.
AWS_ENDPOINT=https://your-bucket.s3.example.com

# (dev, опционально) Открытие файлов из браузерных DevTools в редакторе.
# Опции: code, cursor, windsurf, или пусто чтобы отключить.
LAUNCH_EDITOR=

# (build, опционально, [secret]) Токен Sentry для загрузки source maps при сборке.
SENTRY_AUTH_TOKEN=

# (опц.) Sentry DSN мониторинга ошибок фронта. Пусто = Sentry выключен.
NUXT_PUBLIC_SENTRY_DSN=
